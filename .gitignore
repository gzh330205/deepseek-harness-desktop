node_modules/
dist/
src-tauri/target/
.env
.env.*
!.env.example
# Tauri updater private signing key: keep only the public key in Git.
src-tauri/keys/*.key
!src-tauri/keys/*.key.pub

# Electron P0 shell: local build and smoke-test artifacts
electron/*.log
electron/release/
electron/runtime/
electron/.runtime-build/
electron/release-debug/

# Electron 壳的 minisign 私钥（唯一副本另存于 %USERPROFILE%\.dsh-desktop-keys）
electron/keys/*.key
!electron/keys/*.key.pub
