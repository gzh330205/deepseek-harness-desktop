<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Scanning the QR code the desktop settings page shows. Not required: the address can be typed. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />

  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Pocket"
    android:usesCleartextTraffic="true">
    <!--
      Cleartext is required, not an oversight: the desktop gateway serves plain HTTP on the local
      network, and that is where the phone starts. The public tunnel (P3) is HTTPS. Refusing cleartext
      would make LAN phone access impossible, and the traffic never leaves the local network.
    -->

    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
      android:exported="true"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
        dshpocket://connect?url=… : the desktop's QR code becomes usable by any camera app, not only
        our in-app scanner — the system camera opens this link, the app fills in the address and asks
        for the password. Only the address travels this way; the password is always typed.
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:host="connect" android:scheme="dshpocket" />
      </intent-filter>
    </activity>

    <!--
      The library's own CaptureActivity is `sensorLandscape`, so scanning forced a sideways view.
      Redeclaring *that* activity fights the manifest merger (theme + orientation differ), so we
      declare a subclass of our own instead: portrait, same capture theme, nothing else changed.
    -->
    <activity
      android:name=".PocketCaptureActivity"
      android:configChanges="orientation|screenSize|keyboardHidden"
      android:exported="false"
      android:screenOrientation="portrait"
      android:theme="@style/zxing_CaptureTheme" />

  </application>
</manifest>
