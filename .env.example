# Optional full path or command name used to launch DSH.
# On Windows, use a .cmd/.exe file so Rust can launch it directly.
# DSH_DESKTOP_DSH_COMMAND=C:\\Users\\you\\AppData\\Roaming\\npm\\dsh.cmd

# Optional fixed loopback port for the desktop-managed DSH service.
# Defaults to 41729; the settings file (service.port) is used when this is unset.
# DSH_DESKTOP_PORT=41729

# Dev convenience: absolute path of the DSH panel plugin entry shipped as a
# Tauri resource (resources/dsh-desktop-shell/index.js). Not needed in installers.
# DSH_DESKTOP_PLUGIN_PATH=D:\\path\\to\\repo\\src-tauri\\resources\\dsh-desktop-shell\\index.js

# Local release build only: path to the private Tauri updater signing key.
# Do not commit this key. CI receives its content through GitHub Actions secrets.
# TAURI_SIGNING_PRIVATE_KEY_PATH=src-tauri/keys/dsh-desktop.key
